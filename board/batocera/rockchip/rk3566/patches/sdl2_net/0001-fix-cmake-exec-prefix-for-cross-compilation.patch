Fix cmake config exec_prefix for cross-compilation

The autotools-generated cmake config file uses a hardcoded exec_prefix
from ./configure, which resolves to /usr on the host system instead of
the cross-compilation sysroot. Use ${prefix} (which is derived from
CMAKE_CURRENT_LIST_DIR) to make it sysroot-relative.

--- a/sdl2_net-config.cmake.in
+++ b/sdl2_net-config.cmake.in
@@ -9,7 +9,7 @@
 set(SDL2_net_FOUND TRUE)

 get_filename_component(prefix "${CMAKE_CURRENT_LIST_DIR}/@cmake_prefix_relpath@" ABSOLUTE)
-set(exec_prefix "@exec_prefix@")
+set(exec_prefix "${prefix}")
 set(bindir "@bindir@")
 set(includedir "@includedir@")
 set(libdir "@libdir@")
