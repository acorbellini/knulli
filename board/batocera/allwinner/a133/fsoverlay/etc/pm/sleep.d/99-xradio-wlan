#!/bin/bash

BOARD=$(cat /boot/boot/batocera.board)
# We only want the script to run for these devices
if [ "$BOARD" != "trimui-brick" ] && [ "$BOARD" != "trimui-smart-pro" ]; then
    exit 1
fi

case "${1}" in
   suspend)
      # Disable USB
      echo 'usb1' | tee /sys/bus/usb/drivers/usb/unbind

      # Disable xradio Wi-Fi drivers
      rfkill block wifi
      rmmod xradio_wlan
      ;;
   thaw|resume)
      # Re-enable USB
      echo 'usb1' | tee /sys/bus/usb/drivers/usb/bind

      # Re-enable xradio Wi-Fi drivers
      if [ "$BOARD" = "trimui-smart-pro" ]; then
        insmod /lib/modules/4.9.191/xradio_wlan_tsp.ko
      else
        insmod /lib/modules/4.9.191/xradio_wlan.ko
      fi
      rfkill unblock wifi

      # Wait for wlan0 to appear after module reload
      for i in $(seq 1 20); do
          [ -d /sys/class/net/wlan0 ] && break
          sleep 0.25
      done

      # Disable power save after module reload to prevent BSS lost disconnections
      iw dev wlan0 set power_save off 2>/dev/null

      # If a netplay hotspot was active, restart it instead of letting connman reconnect as station
      if [ -f /tmp/.adhoc_ap_enabled ] && [ -d /sys/class/net/wlan0 ]; then
          INTERFACE=wlan0
          SSID=$(batocera-settings-get wifi.adhoc.ssid)
          PASSPHRASE=$(batocera-settings-get wifi.adhoc.key)
          PASSPHRASE=${PASSPHRASE:-12345678}

          killall hostapd 2>/dev/null
          killall dnsmasq 2>/dev/null
          connmanctl services 2>/dev/null | awk '/wifi_/ {print $NF}' | while read svc; do
              connmanctl disconnect "$svc" 2>/dev/null
          done

          ip link set "$INTERFACE" up
          ip addr flush dev "$INTERFACE"
          sleep 0.1
          ip addr add 192.168.4.1/24 dev "$INTERFACE"

          hostapd /tmp/hostapd.conf &
          echo $! > /tmp/hostapd.pid

          dnsmasq --interface="$INTERFACE" \
                  --bind-interfaces \
                  --dhcp-range=192.168.4.2,192.168.4.20,255.255.255.0,12h \
                  --dhcp-leasefile=/tmp/dnsmasq.leases \
                  --pid-file=/tmp/dnsmasq.pid \
                  --no-resolv

          for i in $(seq 1 100); do
              iw dev "$INTERFACE" info | grep -q "type AP" && break
              sleep 0.1
          done
          iw dev "$INTERFACE" set power_save off 2>/dev/null
      fi
      ;;
esac
exit 0
