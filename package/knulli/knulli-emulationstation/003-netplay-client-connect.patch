+
+	settings->addGroup(_("HOST NOT FOUND"));
+	settings->addWithDescription(_("NO HOST WAS FOUND"), _("MAKE SURE THE HOST HAS STARTED THE GAME"), nullptr, nullptr);
+
+	settings->addEntry(_U("\uF002 ") + _("SEARCH AGAIN"), false, [this, settings]
+	{
+		mClosingSettings = true;
+		Window* w = mWindow;
+		auto* s = settings;
+		w->postToUiThread([s]() { s->close(); });
+		startDiscovery();
+	});
+
+	settings->addGroup(_("MANUAL CONNECTION"));
+
+	SystemConf::getInstance()->set("netplay.client.host_port", std::to_string(defaultPort));
+
+	settings->addInputTextRow(_("HOST IP"), "netplay.client.host_ip", false);
+	settings->addInputTextRow(_("PORT"), "netplay.client.host_port", false);
+	settings->addInputTextRow(_("PASSWORD"), "netplay.client.password", true);
+
+	settings->addEntry(_U("\uF144 ") + _("LAUNCH GAME"), false, [this, settings]
+	{
+		if (mState == LAUNCHING) return;
+
+		std::string ip = SystemConf::getInstance()->get("netplay.client.host_ip");
+		std::string portStr = SystemConf::getInstance()->get("netplay.client.host_port");
+		std::string password = SystemConf::getInstance()->get("netplay.client.password");
+
+		int port = Utils::String::toInteger(portStr);
+		if (port <= 0)
+			port = NETPLAY_DEFAULT_PORT;
+
+		if (ip.empty())
+		{
+			mWindow->pushGui(new GuiMsgBox(mWindow, _("PLEASE ENTER A HOST IP"), _("OK"), nullptr));
+			return;
+		}
+
+		mState = LAUNCHING;
+		mClosingSettings = true;
+		Window* w = mWindow;
+		auto* s = settings;
+		std::string launchIp = ip;
+		int launchPort = port;
+		std::string launchPassword = password;
+		w->postToUiThread([this, s, launchIp, launchPort, launchPassword]()
+		{
+			s->close();
+			launchGame(launchIp, launchPort, launchPassword);
+		});
+	});
+
+	mWindow->pushGui(settings);
+}
+
+void GuiNetPlayClientConnect::launchGame(const std::string& ip, int port, const std::string& password)
+{
+	SystemConf::getInstance()->setBool("global.netplay", true);
+	SystemConf::getInstance()->saveSystemConf();
+
+	LaunchGameOptions options;
+	options.netPlayMode = CLIENT;
+	options.ip = ip;
+	options.port = port;
+
+	if (!password.empty())
+		SystemConf::getInstance()->set("global.netplay.password", password);
+
+	ViewController::get()->launch(mGame, options);
+	if (mParentMenu)
+		mParentMenu->close();
+	delete this;
+}
+
+void GuiNetPlayClientConnect::update(int deltaTime)
+{
+	GuiComponent::update(deltaTime);
+
+	if (mShowBusy)
+		mBusyAnim.update(deltaTime);
+
+	// Handle LAN discovery responses
+	if (mState == DISCOVERING && mLanSocket >= 0)
+	{
+		struct sockaddr_in serverAddr;
+		socklen_t addrLen = sizeof(serverAddr);
+		ad_packet response;
+
+		ssize_t received = recvfrom(mLanSocket, &response, sizeof(response), 0,
+			(struct sockaddr*)&serverAddr, &addrLen);
+
+		if (received == sizeof(response) && ntohl(response.header) == DISCOVERY_RESPONSE_MAGIC)
+		{
+			mHostFound = true;
+			mHostIp = inet_ntoa(serverAddr.sin_addr);
+			mHostPort = ntohl(response.port);
+			mHostHasPassword = ntohl(response.has_password) != 0;
+			mHostNick = response.nick;
+
+			LOG(LogInfo) << "GuiNetPlayClientConnect: Found host at " << mHostIp << ":" << mHostPort;
+			showServerFound(mHostIp, mHostPort, mHostHasPassword, mHostNick);
+			return;
+		}
+
+		mDiscoveryTimeout += deltaTime;
+
+		// Re-send discovery query every 2 seconds
+		if (mDiscoveryTimeout % 2000 < deltaTime)
+		{
+			int port = Utils::String::toInteger(SystemConf::getInstance()->get("global.netplay.port"));
+			if (port <= 0)
+				port = NETPLAY_DEFAULT_PORT;
+
+			uint32_t query_magic = htonl(DISCOVERY_QUERY_MAGIC);
+
+			struct sockaddr_in broadcastAddr;
+			memset(&broadcastAddr, 0, sizeof(broadcastAddr));
+			broadcastAddr.sin_family = AF_INET;
+			broadcastAddr.sin_port = htons(port);
+			broadcastAddr.sin_addr.s_addr = htonl(INADDR_BROADCAST);
+			sendto(mLanSocket, &query_magic, sizeof(query_magic), 0, (struct sockaddr*)&broadcastAddr, sizeof(broadcastAddr));
+
+			broadcastAddr.sin_addr.s_addr = inet_addr("192.168.4.1");
+			sendto(mLanSocket, &query_magic, sizeof(query_magic), 0, (struct sockaddr*)&broadcastAddr, sizeof(broadcastAddr));
+		}
+
+		if (mDiscoveryTimeout >= DISCOVERY_TIMEOUT_MS)
+		{
+			LOG(LogWarning) << "GuiNetPlayClientConnect: Discovery timeout";
+			showServerNotFound();
+		}
+	}
+}
+
+void GuiNetPlayClientConnect::render(const Transform4x4f& parentTrans)
+{
+	Transform4x4f trans = parentTrans * getTransform();
+
+	if (mShowBusy)
+	{
+		Renderer::setMatrix(trans);
+		mBusyAnim.render(trans);
+	}
+
+	renderChildren(trans);
+}
+
+bool GuiNetPlayClientConnect::input(InputConfig* config, Input input)
+{
+	if (input.value != 0 && config->isMappedTo(BUTTON_BACK, input))
+	{
+		if (mWifiThreadRunning)
+		{
+			// Thread is running — can't delete now or the queued lambda will crash.
+			// Set cancelled flag; the thread callback will handle cleanup.
+			mCancelled = true;
+			return true;
+		}
+		delete this;
+		return true;
+	}
+
+	return GuiComponent::input(config, input);
+}
