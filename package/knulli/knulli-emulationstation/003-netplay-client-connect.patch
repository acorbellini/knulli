+#include "GuiNetPlayClientConnect.h"
+#include "FileData.h"
+#include "SystemData.h"
+#include "ApiSystem.h"
+#include "SystemConf.h"
+#include "LocaleES.h"
+#include "views/ViewController.h"
+#include "guis/GuiSettings.h"
+#include "guis/GuiMsgBox.h"
+#include "guis/GuiLoading.h"
+#include "guis/GuiWifi.h"
+#include "components/SwitchComponent.h"
+#include "Log.h"
+
+#include <sys/socket.h>
+#include <netinet/in.h>
+#include <arpa/inet.h>
+#include <fcntl.h>
+#include <unistd.h>
+#include <cstring>
+
+#define NETPLAY_AP_SSID "NETPLAY_AP"
+#define NETPLAY_AP_KEY  "12345678"
+#define NETPLAY_DEFAULT_PORT 55435
+#define DISCOVERY_TIMEOUT_MS 10000
+
+GuiNetPlayClientConnect::GuiNetPlayClientConnect(Window* window, FileData* game, GuiSettings* parentMenu)
+	: GuiComponent(window), mBusyAnim(window)
+{
+	mGame = game;
+	mParentMenu = parentMenu;
+	mState = CHECKING_WIFI;
+	mShowBusy = true;
+	mWifiThread = nullptr;
+	mWifiThreadRunning = false;
+	mLanSocket = -1;
+	mDiscoveryTimeout = 0;
+	mHostFound = false;
+	mHostPort = NETPLAY_DEFAULT_PORT;
+	mHostHasPassword = false;
+	mClosingSettings = false;
+	mCancelled = false;
+
+	setSize((float)Renderer::getScreenWidth(), (float)Renderer::getScreenHeight());
+
+	mBusyAnim.setSize(mSize);
+	mBusyAnim.setText(_("CHECKING WI-FI..."));
+
+	// Start WiFi check in background
+	checkWifi();
+}
+
+GuiNetPlayClientConnect::~GuiNetPlayClientConnect()
+{
+	if (mWifiThread)
+	{
+		mWifiThreadRunning = false;
+		mWifiThread->join();
+		delete mWifiThread;
+	}
+
+	if (mLanSocket >= 0)
+		::close(mLanSocket);
+}
+
+void GuiNetPlayClientConnect::setBusy(const std::string& text)
+{
+	mShowBusy = true;
+	mBusyAnim.setText(text);
+	mBusyAnim.setSize(mSize);
+}
+
+void GuiNetPlayClientConnect::checkWifi()
+{
+	mState = CHECKING_WIFI;
+	setBusy(_("SCANNING WI-FI NETWORKS..."));
+
+	// Clean up old thread if any
+	if (mWifiThread)
+	{
+		if (mWifiThread->joinable())
+			mWifiThread->join();
+		delete mWifiThread;
+		mWifiThread = nullptr;
+	}
+
+	mWifiThreadRunning = true;
+	mWifiThread = new std::thread([this]()
+	{
+		std::string currentSsid = ApiSystem::getInstance()->getWifiStatus();
+
+		// Look up stored key for current network (uses batocera-settings-get, more robust than SystemConf)
+		std::string currentKey;
+		if (!currentSsid.empty())
+			currentKey = ApiSystem::getInstance()->getWifiKey(currentSsid);
+
+		// Scan for networks and look for NETPLAY SSIDs
+		std::vector<std::string> networks = ApiSystem::getInstance()->getWifiNetworks(true);
+		std::string netplaySsid;
+		for (auto& net : networks)
+		{
+			if (net.find("NETPLAY") != std::string::npos)
+			{
+				netplaySsid = net;
+				break;
+			}
+		}
+
+		// Post results to UI thread
+		Window* window = mWindow;
+		window->postToUiThread([this, currentSsid, currentKey, netplaySsid]()
+		{
+			mWifiThreadRunning = false;
+			if (mCancelled) { delete this; return; }
+			showWifiOptions(currentSsid, netplaySsid, currentKey);
+		});
+	});
+}
+
+void GuiNetPlayClientConnect::showWifiOptions(const std::string& currentSsid, const std::string& netplaySsid,
+	const std::string& wifiKey, bool skipPrePopulate)
+{
+	mState = WIFI_OPTIONS;
+	mShowBusy = false;
+
+	mClosingSettings = false;
+	auto* settings = new GuiSettings(mWindow, _("JOIN DIRECT NETPLAY"));
+	settings->setSubTitle(mGame->getName());
+	settings->setCloseButton("back");
+	settings->onFinalize([this]() { if (!mClosingSettings) delete this; });
+
+	settings->addGroup(_("WI-FI CONNECTION"));
+
+	bool isConnected = !currentSsid.empty();
+
+	// Pre-populate SSID and key (only on first show, not after picker re-shows)
+	if (!skipPrePopulate)
+	{
+		if (isConnected)
+		{
+			SystemConf::getInstance()->set("netplay.client.wifi_ssid", currentSsid);
+			if (currentSsid == NETPLAY_AP_SSID)
+				SystemConf::getInstance()->set("netplay.client.wifi_key", NETPLAY_AP_KEY);
+			else
+				SystemConf::getInstance()->set("netplay.client.wifi_key", wifiKey);
+		}
+		else if (!netplaySsid.empty())
+		{
+			// Not connected but NETPLAY SSID found — pre-populate with it
+			SystemConf::getInstance()->set("netplay.client.wifi_ssid", netplaySsid);
+			SystemConf::getInstance()->set("netplay.client.wifi_key", NETPLAY_AP_KEY);
+		}
+		else
+		{
+			SystemConf::getInstance()->set("netplay.client.wifi_ssid", "");
+			SystemConf::getInstance()->set("netplay.client.wifi_key", "");
+		}
+	}
+
+	// "USE NETPLAY_AP" shortcut — shown when NETPLAY SSID was found AND user is already connected
+	// (offers to switch from current network to the NETPLAY AP)
+	if (!netplaySsid.empty() && isConnected && currentSsid != netplaySsid)
+	{
+		settings->addEntry(_U("\uF0C1 ") + _("USE") + " " + netplaySsid, false, [this, settings, netplaySsid, currentSsid, wifiKey]
+		{
+			SystemConf::getInstance()->set("netplay.client.wifi_ssid", netplaySsid);
+			SystemConf::getInstance()->set("netplay.client.wifi_key", NETPLAY_AP_KEY);
+			mClosingSettings = true;
+			Window* w = mWindow;
+			auto* s = settings;
+			std::string nSsid = netplaySsid;
+			std::string cSsid = currentSsid;
+			std::string cKey = wifiKey;
+			w->postToUiThread([this, s, cSsid, nSsid, cKey]()
+			{
+				s->close();
+				showWifiOptions(cSsid, nSsid, cKey, true);
+			});
+		});
+	}
+
+	// WiFi SSID picker — after picking, close and re-show so key field refreshes
+	auto openWifiPicker = [this, settings, currentSsid, netplaySsid](Window* win, std::string title, std::string data,
+		const std::function<void(std::string)>& onsave)
+	{
+		auto wrappedSave = [this, settings, onsave, currentSsid, netplaySsid](const std::string& ssid)
+		{
+			onsave(ssid);
+			// Look up stored key for the picked network
+			std::string pickedKey;
+			if (ssid.find("NETPLAY") != std::string::npos)
+				pickedKey = NETPLAY_AP_KEY;
+			else
+				pickedKey = ApiSystem::getInstance()->getWifiKey(ssid);
+			SystemConf::getInstance()->set("netplay.client.wifi_key", pickedKey);
+			// Re-show wifi options so the key field picks up the new value
+			mClosingSettings = true;
+			Window* w = mWindow;
+			auto* s = settings;
+			std::string cSsid = currentSsid;
+			std::string nSsid = netplaySsid;
+			std::string pKey = pickedKey;
+			w->postToUiThread([this, s, cSsid, nSsid, pKey]()
+			{
+				s->close();
+				showWifiOptions(cSsid, nSsid, pKey, true);
+			});
+		};
+		win->pushGui(new GuiWifi(win, title, data, wrappedSave));
+	};
+
+	settings->addInputTextRow(_("WIFI SSID"), "netplay.client.wifi_ssid", false, false, openWifiPicker);
+	settings->addInputTextRow(_("WIFI KEY"), "netplay.client.wifi_key", true);
+
+	// IP address (read-only display)
+	std::string ip = ApiSystem::getInstance()->getIpAdress();
+	settings->addWithDescription(_("IP ADDRESS"), ip, nullptr, nullptr);
+
+	settings->addGroup(_("ACTIONS"));
+
+	// Single action: connect (if needed) and find host
+	std::string savedCurrentSsid = currentSsid;
+	settings->addEntry(_U("\uF0C1 ") + _("CONNECT AND FIND HOST"), false, [this, settings, savedCurrentSsid]
+	{
+		std::string ssid = SystemConf::getInstance()->get("netplay.client.wifi_ssid");
+		std::string key = SystemConf::getInstance()->get("netplay.client.wifi_key");
+
+		if (ssid.empty())
+		{
+			mWindow->pushGui(new GuiMsgBox(mWindow, _("PLEASE SELECT A WI-FI NETWORK"), _("OK"), nullptr));
+			return;
+		}
+
+		mClosingSettings = true;
+		Window* w = mWindow;
+		auto* s = settings;
+		w->postToUiThread([s]() { s->close(); });
+		connectAndFindHost(ssid, key, savedCurrentSsid);
+	});
+
+	mWindow->pushGui(settings);
+}
+
+void GuiNetPlayClientConnect::connectAndFindHost(const std::string& selectedSsid, const std::string& key, const std::string& currentSsid)
+{
+	// If already connected to the selected SSID AND we have an IP, skip WiFi connect
+	if (!currentSsid.empty() && selectedSsid == currentSsid)
+	{
+		std::string ip = ApiSystem::getInstance()->getIpAdress();
+		if (!ip.empty() && ip != "NOT CONNECTED")
+		{
+			startDiscovery();
+			return;
+		}
+		// Connected but no IP — reconnect
+	}
+
+	// Connect (or reconnect) to the selected network
+	connectToWifi(selectedSsid, key);
+}
+
+void GuiNetPlayClientConnect::connectToWifi(const std::string& ssid, const std::string& key)
+{
+	mState = CONNECTING;
+	setBusy(_("CONNECTING TO ") + ssid + "...");
+
+	// Clean up old thread if any
+	if (mWifiThread)
+	{
+		if (mWifiThread->joinable())
+			mWifiThread->join();
+		delete mWifiThread;
+		mWifiThread = nullptr;
+	}
+
+	mWifiThreadRunning = true;
+	std::string connectSsid = ssid;
+	std::string connectKey = key;
+
+	mWifiThread = new std::thread([this, connectSsid, connectKey]()
+	{
+		// Save current SSID for later restoration (same as connect_netplay does)
+		std::string currentSsid = ApiSystem::getInstance()->getWifiStatus();
+		if (!currentSsid.empty())
+		{
+			FILE* f = fopen("/tmp/.netplay_client_wifi_restore", "w");
+			if (f) { fprintf(f, "%s", currentSsid.c_str()); fclose(f); }
+		}
+
+		// Use enableWifi — the same path as the regular NETWORK SETTINGS menu
+		bool ok = ApiSystem::getInstance()->enableWifi(connectSsid, connectKey);
+
+		// Check if we actually got an IP (WiFi may connect but DHCP can fail)
+		std::string ip;
+		if (ok)
+			ip = ApiSystem::getInstance()->getIpAdress();
+		bool hasIp = ok && !ip.empty() && ip != "NOT CONNECTED";
+
+		Window* window = mWindow;
+		window->postToUiThread([this, ok, hasIp]()
+		{
+			mWifiThreadRunning = false;
+			if (mCancelled) { delete this; return; }
+			if (hasIp)
+			{
+				startDiscovery();
+			}
+			else
+			{
+				mShowBusy = false;
+				mWindow->pushGui(new GuiMsgBox(mWindow,
+					ok ? _("CONNECTED BUT NO IP ADDRESS ASSIGNED. TRY AGAIN.") : _("FAILED TO CONNECT TO WI-FI"),
+					_("RETRY"), [this]() { checkWifi(); },
+					_("CANCEL"), [this]() { delete this; }));
+			}
+		});
+	});
+}
+
+void GuiNetPlayClientConnect::startDiscovery()
+{
+	mState = DISCOVERING;
+	setBusy(_("LOOKING FOR HOST..."));
+	mDiscoveryTimeout = 0;
+	mHostFound = false;
+
+	// Close old socket if any
+	if (mLanSocket >= 0)
+		::close(mLanSocket);
+
+	int port = Utils::String::toInteger(SystemConf::getInstance()->get("global.netplay.port"));
+	if (port <= 0)
+		port = NETPLAY_DEFAULT_PORT;
+
+	mLanSocket = socket(AF_INET, SOCK_DGRAM, 0);
+	if (mLanSocket < 0)
+	{
+		LOG(LogError) << "GuiNetPlayClientConnect: Failed to create UDP socket";
+		showServerNotFound();
+		return;
+	}
+
+	int broadcastEnable = 1;
+	setsockopt(mLanSocket, SOL_SOCKET, SO_BROADCAST, &broadcastEnable, sizeof(broadcastEnable));
+
+	int flags = fcntl(mLanSocket, F_GETFL, 0);
+	fcntl(mLanSocket, F_SETFL, flags | O_NONBLOCK);
+
+	// Send discovery query
+	uint32_t query_magic = htonl(DISCOVERY_QUERY_MAGIC);
+
+	struct sockaddr_in broadcastAddr;
+	memset(&broadcastAddr, 0, sizeof(broadcastAddr));
+	broadcastAddr.sin_family = AF_INET;
+	broadcastAddr.sin_port = htons(port);
+	broadcastAddr.sin_addr.s_addr = htonl(INADDR_BROADCAST);
+	sendto(mLanSocket, &query_magic, sizeof(query_magic), 0, (struct sockaddr*)&broadcastAddr, sizeof(broadcastAddr));
+
+	// Also send directly to 192.168.4.1 (AP default)
+	broadcastAddr.sin_addr.s_addr = inet_addr("192.168.4.1");
+	sendto(mLanSocket, &query_magic, sizeof(query_magic), 0, (struct sockaddr*)&broadcastAddr, sizeof(broadcastAddr));
+}
+
+void GuiNetPlayClientConnect::showServerFound(const std::string& hostIp, int hostPort, bool hasPassword, const std::string& hostNick)
+{
+	mState = SERVER_SETTINGS;
+	mShowBusy = false;
+
+	if (mLanSocket >= 0)
+	{
+		::close(mLanSocket);
+		mLanSocket = -1;
+	}
+
+	mClosingSettings = false;
+	auto* settings = new GuiSettings(mWindow, _("JOIN DIRECT NETPLAY"));
+	settings->setSubTitle(mGame->getName());
+	settings->setCloseButton("back");
+	settings->onFinalize([this]() { if (!mClosingSettings) checkWifi(); });
+
+	settings->addGroup(_("HOST FOUND"));
+
+	if (!hostNick.empty())
+		settings->addWithDescription(_("HOST"), hostNick, nullptr, nullptr);
+
+	SystemConf::getInstance()->set("netplay.client.host_ip", hostIp);
+	SystemConf::getInstance()->set("netplay.client.host_port", std::to_string(hostPort));
+
+	settings->addInputTextRow(_("HOST IP"), "netplay.client.host_ip", false);
+	settings->addInputTextRow(_("PORT"), "netplay.client.host_port", false);
+
+	if (hasPassword)
+		settings->addWithDescription(_("PASSWORD REQUIRED"), "", nullptr, nullptr);
+
+	settings->addInputTextRow(_("PASSWORD"), "netplay.client.password", true);
+
+	settings->addGroup(_("ACTIONS"));
+
+	settings->addEntry(_U("\uF144 ") + _("LAUNCH GAME"), false, [this, settings]
+	{
+		if (mState == LAUNCHING) return;
+
+		std::string ip = SystemConf::getInstance()->get("netplay.client.host_ip");
+		std::string portStr = SystemConf::getInstance()->get("netplay.client.host_port");
+		std::string password = SystemConf::getInstance()->get("netplay.client.password");
+
+		int port = Utils::String::toInteger(portStr);
+		if (port <= 0)
+			port = NETPLAY_DEFAULT_PORT;
+
+		if (ip.empty())
+		{
+			mWindow->pushGui(new GuiMsgBox(mWindow, _("PLEASE ENTER A HOST IP"), _("OK"), nullptr));
+			return;
+		}
+
+		mState = LAUNCHING;
+		mClosingSettings = true;
+		Window* w = mWindow;
+		auto* s = settings;
+		std::string launchIp = ip;
+		int launchPort = port;
+		std::string launchPassword = password;
+		w->postToUiThread([this, s, launchIp, launchPort, launchPassword]()
+		{
+			s->close();
+			launchGame(launchIp, launchPort, launchPassword);
+		});
+	});
+
+	settings->addEntry(_U("\uF002 ") + _("SEARCH AGAIN"), false, [this, settings]
+	{
+		mClosingSettings = true;
+		Window* w = mWindow;
+		auto* s = settings;
+		w->postToUiThread([s]() { s->close(); });
+		startDiscovery();
+	});
+
+	mWindow->pushGui(settings);
+}
