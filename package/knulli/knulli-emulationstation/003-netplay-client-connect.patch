+
+	int defaultPort = Utils::String::toInteger(SystemConf::getInstance()->get("global.netplay.port"));
+	if (defaultPort <= 0)
+		defaultPort = NETPLAY_DEFAULT_PORT;
+
+	mClosingSettings = false;
+	auto* settings = new GuiSettings(mWindow, _("JOIN DIRECT NETPLAY"));
+	settings->setSubTitle(mGame->getName());
