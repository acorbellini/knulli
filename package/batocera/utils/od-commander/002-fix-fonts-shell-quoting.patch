+# Generate a header for FONTS and LOW_DPI_FONTS definitions.
+# These values contain braces and quotes that get corrupted by shell
+# brace expansion when passed as -D flags on the compiler command line.
+set(_FONTS_HEADER "/* Auto-generated by CMake */\n")
+if(DEFINED FONTS)
+  string(APPEND _FONTS_HEADER "#define FONTS ${FONTS}\n")
+endif()
+if(DEFINED LOW_DPI_FONTS)
+  string(APPEND _FONTS_HEADER "#define LOW_DPI_FONTS ${LOW_DPI_FONTS}\n")
+endif()
+file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/fonts_config.h" "${_FONTS_HEADER}")
+target_include_directories(${BIN_TARGET} PRIVATE ${CMAKE_CURRENT_BINARY_DIR})
+
 # These variables are passed as C macro definitons if they're not empty.
